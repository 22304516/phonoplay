generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model WordList {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  words       Word[]
  activities  Activity[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Word {
  id          Int       @id @default(autoincrement())
  english     String
  phoneme     String
  wordListId  Int
  wordList    WordList  @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  phonemes    Phoneme[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Phoneme {
  id        Int      @id @default(autoincrement())
  symbol    String
  position  Int
  wordId    Int
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model Activity {
  id          Int        @id @default(autoincrement())
  name        String
  type        ActivityType
  difficulty  Difficulty
  hint        Boolean    @default(true)
  wordListId  Int
  wordList    WordList   @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  settings    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}