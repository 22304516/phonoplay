generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model WordList {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  words       Word[]
  activities  Activity[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Word {
  id         Int        @id @default(autoincrement())
  english    String
  phoneme    String
  wordListId Int
  wordList   WordList   @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  phonemes   Phoneme[]
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Phoneme {
  id       Int    @id @default(autoincrement())
  symbol   String
  position Int
  wordId   Int
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model Activity {
  id         Int          @id @default(autoincrement())
  name       String
  type       ActivityType
  difficulty Difficulty
  hint       Boolean      @default(true)
  wordListId Int
  wordList   WordList     @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  wordId     Int?
  word       Word?        @relation(fields: [wordId], references: [id], onDelete: SetNull)
  settings   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model GenerationEvent {
  id           Int          @id @default(autoincrement())
  type         ActivityType
  success      Boolean
  errorMessage String?
  durationMs   Int?
  source       EventSource  @default(LIVE)
  createdAt    DateTime     @default(now())

  @@index([type, createdAt])
  @@index([success, createdAt])
}

model UsageEvent {
  id           Int           @id @default(autoincrement())
  page         String
  activityType ActivityType?
  durationMs   Int?
  sessionId    String?
  source       EventSource   @default(LIVE)
  createdAt    DateTime      @default(now())

  @@index([page, createdAt])
  @@index([activityType, createdAt])
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum EventSource {
  LIVE
  DEMO
}
